{
  "name": "mysitter",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin",
    "packages/types",
    "packages/api-client"
  ],
  "_notes": {
    "mobile": "Expo/React Native is excluded from the root workspace on Windows due to react-native's deep Android path tree exceeding Windows path limits. Run `cd apps/mobile && npm install` separately."
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  }
}
