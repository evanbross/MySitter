# Copy this file to .env.local and fill in values before running the web app.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never commit .env.local — it is gitignored.

# ─── API ──────────────────────────────────────────────────────────────────────
# Defaults to "/api" (Vite dev proxy) if not set. Set for production builds.
# VITE_API_URL=http://localhost:8000

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Defaults to "ws://localhost:8000" if not set. Use "wss://" in production.
# VITE_WS_URL=ws://localhost:8000

# ─── Mapbox ───────────────────────────────────────────────────────────────────
# Use the PUBLIC (pk.*) token here — the secret (sk.*) token is API-only.
# Obtain from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.eyJ...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Use the PUBLIC (pk_test_... or pk_live_...) key here.
# Obtain from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
