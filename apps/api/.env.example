# Copy this file to .env and fill in values before running the API.
# Never commit .env — it is gitignored.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="MyWatcher API"
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# ─── Database ─────────────────────────────────────────────────────────────────
# Use postgresql+asyncpg:// for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://mywatcher:mywatcher_dev@localhost:5432/mywatcher
# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql://mywatcher:mywatcher_dev@localhost:5432/mywatcher

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── WebAuthn (Passkeys) ──────────────────────────────────────────────────────
# In dev, rp_id = localhost. In prod, set to your actual domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MyWatcher
WEBAUTHN_ORIGIN=http://localhost:5173

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ─── Mapbox ───────────────────────────────────────────────────────────────────
MAPBOX_SECRET_TOKEN=sk.eyJ...

# ─── DigitalOcean Spaces (S3-compatible) ──────────────────────────────────────
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_KEY=...
SPACES_SECRET=...
SPACES_BUCKET=mywatcher
SPACES_REGION=nyc3
