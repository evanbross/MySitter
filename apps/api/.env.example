# Copy this file to .env and fill in values before running the API.
# Never commit .env — it is gitignored.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="mysitter API"
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Get connection strings from https://console.neon.tech → your project → Connection Details
# Use postgresql+asyncpg:// for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/mysitter_db?sslmode=require
# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql+psycopg2://user:password@ep-xxx.neon.tech/mysitter_db?sslmode=require

# ─── Redis ────────────────────────────────────────────────────────────────────
# Dev: shared infra stack (../infra/docker-compose.yml). Prod: set to your managed Redis URL.
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── WebAuthn (Passkeys) ──────────────────────────────────────────────────────
# In dev, rp_id = localhost. In prod, set to your actual domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=mysitter
WEBAUTHN_ORIGIN=http://localhost:5173

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# ─── Email ────────────────────────────────────────────────────────────────────
# Dev: point at MailHog (shared infra stack) — no real emails sent.
# Prod: remove SMTP_HOST/PORT overrides; set RESEND_API_KEY instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mysitter.local
RESEND_API_KEY=re_...

# ─── Mapbox ───────────────────────────────────────────────────────────────────
MAPBOX_SECRET_TOKEN=sk.eyJ...

# ─── Cloudflare R2 (S3-compatible) ────────────────────────────────────────────
# S3 API endpoint used for presigned uploads.
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Public base URL used by the browser to display uploaded assets.
# Use a custom domain or the bucket's r2.dev URL once public access is enabled.
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.example.com
CLOUDFLARE_R2_SITTER_BUCKET=mysitter
CLOUDFLARE_R2_REGION=auto

# Least-privilege app credentials for object read/write operations.
CLOUDFLARE_R2_DATA_RW_ACCESS_KEY=...
CLOUDFLARE_R2_DATA_RW_SECRET=...

# Admin credentials are reserved for bucket-management workflows.
CLOUDFLARE_R2_ADMIN_TOKEN=
CLOUDFLARE_R2_ADMIN_ACCESS_KEY=
CLOUDFLARE_R2_ADMIN_SECRET=
